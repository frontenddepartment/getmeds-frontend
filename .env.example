# Vidrys (AI visibility). See "Vidrys Developer Setup Guide".

# Signs every webhook POST to /api/vidrys/content (X-GEO-Signature). Server-only; keep secret.
# Vidrys never generates this: make one up (e.g. `openssl rand -hex 32`), set it here and paste
# the same value in Vidrys -> Settings -> Publishing -> Webhook (custom site) -> Signing secret.
VIDRYS_SIGNING_SECRET=paste-the-secret-you-generated

# Site key: the k= value of the AI Traffic tag in Vidrys -> sidebar Analyst -> AI traffic ->
# "Install tracking" card, step 2 "Add this code". Public: it appears in the page's script URL.
NEXT_PUBLIC_VIDRYS_SITE_KEY=paste-site-key-from-vidrys-ai-traffic-tag

# Where your Sanity Studio is hosted (no trailing slash).
# The webhook answers content.publish with a link to the draft there, for Vidrys' "Published" chip.
SANITY_STUDIO_URL=https://getmeds-database.vercel.app
