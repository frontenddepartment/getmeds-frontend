{
  "version": 2,
  "framework": null,
  "installCommand": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.getmeds.ph"
        }
      ],
      "destination": "https://getmeds.ph/:path*",
      "permanent": true
    },
    {
      "source": "/articles",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/articles.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/articles/:slug*",
      "destination": "/blog/:slug*",
      "permanent": true
    },
    {
      "source": "/article-detail",
      "destination": "/blog-detail",
      "permanent": true
    },
    {
      "source": "/article-detail.html",
      "destination": "/blog-detail",
      "permanent": true
    },
    {
      "source": "/product-range",
      "destination": "/cancer-medicines",
      "permanent": true
    },
    {
      "source": "/product-range.html",
      "destination": "/cancer-medicines",
      "permanent": true
    },
    {
      "source": "/product-range/:path*",
      "destination": "/cancer-medicines/:path*",
      "permanent": true
    },
    {
      "source": "/:slug((?!about-us|blog|blog-detail|cms|masteradlorock|masteradlorockpd|masteradlorockpdprocess|masteradlogriyon|adminadlorock|cancer-medicines|careers|contact-us|csr|edit-profile|global-presence|home-preview|meditations|order-medicines|pap|profile|services|under-development|ungc|api/|wp-json/|public/|uploads/|components/|data/|src/|dist/|node_modules/|_vercel/|[^/]+\\.[^/]+$)[^/]+)",
      "destination": "/blog/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/cms",
      "destination": "https://cms.getmeds.ph/"
    },
    {
      "source": "/cms/:path*",
      "destination": "https://cms.getmeds.ph/:path*"
    },
    {
      "source": "/wp-json/:path*",
      "destination": "https://cms.getmeds.ph/wp-json/:path*"
    },
    {
      "source": "/api/careers",
      "destination": "https://getmeds-test-creation.vercel.app/api/careers"
    },
    {
      "source": "/api/:path*",
      "destination": "https://getmeds-admin.vercel.app/api/:path*"
    },
    {
      "source": "/masteradlogriyon",
      "destination": "https://admin.getmeds.ph/masteradlogriyon"
    },
    {
      "source": "/masteradlogriyon/:path*",
      "destination": "https://admin.getmeds.ph/masteradlogriyon/:path*"
    },
    {
      "source": "/masteradlorock",
      "destination": "https://admin.getmeds.ph/masteradlorock"
    },
    {
      "source": "/masteradlorock/:path*",
      "destination": "https://admin.getmeds.ph/masteradlorock/:path*"
    },
    {
      "source": "/masteradlorockpd",
      "destination": "https://admin.getmeds.ph/masteradlorockpd"
    },
    {
      "source": "/masteradlorockpd/:path*",
      "destination": "https://admin.getmeds.ph/masteradlorockpd/:path*"
    },
    {
      "source": "/masteradlorockpdprocess",
      "destination": "https://admin.getmeds.ph/masteradlorockpdprocess"
    },
    {
      "source": "/masteradlorockpdprocess/:path*",
      "destination": "https://admin.getmeds.ph/masteradlorockpdprocess/:path*"
    },
    {
      "source": "/adminadlorock",
      "destination": "https://admin.getmeds.ph/adminadlorock"
    },
    {
      "source": "/adminadlorock/:path*",
      "destination": "https://admin.getmeds.ph/adminadlorock/:path*"
    },
    {
      "source": "/public/:path*",
      "destination": "https://admin.getmeds.ph/public/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://admin.getmeds.ph/uploads/:path*"
    },
    {
      "source": "/cancer-medicines/:subcategory/:product",
      "destination": "/product-detail.html"
    },
    {
      "source": "/cancer-medicines/:subcategory",
      "destination": "/cancer-medicines.html"
    },
    {
      "source": "/cancer-medicines",
      "destination": "/cancer-medicines.html"
    },
    {
      "source": "/blog/:slug*",
      "destination": "/blog-detail"
    },
    {
      "source": "/blog-detail",
      "destination": "/blog-detail"
    },
    {
      "source": "/blog-detail.html",
      "destination": "/blog-detail"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}