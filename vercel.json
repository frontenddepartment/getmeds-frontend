{
  "version": 2,
  "framework": null,
  "installCommand": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/articles",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/articles.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/articles/:slug*",
      "destination": "/blog/:slug*",
      "permanent": true
    },
    {
      "source": "/article-detail",
      "destination": "/blog-detail",
      "permanent": true
    },
    {
      "source": "/article-detail.html",
      "destination": "/blog-detail",
      "permanent": true
    },
    {
      "source": "/product-range",
      "destination": "/cancer-medicines",
      "permanent": true
    },
    {
      "source": "/product-range.html",
      "destination": "/cancer-medicines",
      "permanent": true
    },
    {
      "source": "/product-range/:path*",
      "destination": "/cancer-medicines/:path*",
      "permanent": true
    },
    {
      "source": "/:slug((?!about-us|blog|blog-detail|cancer-medicines|careers|contact-us|csr|edit-profile|global-presence|home-preview|masteradlorock|meditations|order-medicines|pap|profile|services|under-development|ungc|api/|wp-json/|assets/|components/|data/|src/|dist/|node_modules/|_vercel/|[^/]+\\.[^/]+$)[^/]+)",
      "destination": "/blog/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/wp-json/:path*",
      "destination": "https://cms.getmeds.ph/wp-json/:path*"
    },
    {
      "source": "/api/careers",
      "destination": "https://getmeds-test-creation.vercel.app/api/careers"
    },
    {
      "source": "/api/:path*",
      "destination": "https://getmeds-admin.vercel.app/api/:path*"
    },
    {
      "source": "/cancer-medicines/:subcategory/:product",
      "destination": "/product-detail.html"
    },
    {
      "source": "/cancer-medicines/:subcategory",
      "destination": "/cancer-medicines.html"
    },
    {
      "source": "/cancer-medicines",
      "destination": "/cancer-medicines.html"
    },
    {
      "source": "/blog/:slug*",
      "destination": "/blog-detail"
    },
    {
      "source": "/blog-detail",
      "destination": "/blog-detail"
    },
    {
      "source": "/blog-detail.html",
      "destination": "/blog-detail"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}