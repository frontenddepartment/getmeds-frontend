{
  "version": 2,
  "framework": null,
  "installCommand": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/articles",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/articles.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/articles/:slug*",
      "destination": "/blog/:slug*",
      "permanent": true
    },
    {
      "source": "/article-detail",
      "destination": "/blog-detail",
      "permanent": true
    },
    {
      "source": "/article-detail.html",
      "destination": "/blog-detail",
      "permanent": true
    },
    {
      "source": "/product-range",
      "destination": "/cancer-medicines",
      "permanent": true
    },
    {
      "source": "/product-range.html",
      "destination": "/cancer-medicines",
      "permanent": true
    },
    {
      "source": "/product-range/:path*",
      "destination": "/cancer-medicines/:path*",
      "permanent": true
    },
    {
      "source": "/:slug((?!404|about-us|blog|blog-detail|cancer-medicines|careers|contact-us|csr|edit-profile|global-presence|home-preview|meditations|order-medicines|pap|profile|services|under-development|ungc|api/|wp-json/|assets/|components/|data/|src/|dist/|node_modules/|_vercel/|masteradlorock|masteradlorockpd|masteradlorockpdprocess|masteradlogriyon|adminadlorock|[^/]+\\.[^/]+$)[^/]+)",
      "destination": "/blog/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/public/:path*",
      "destination": "https://admin.getmeds.ph/public/:path*"
    },
    {
      "source": "/masteradmin",
      "destination": "https://admin.getmeds.ph/masteradmin"
    },
    {
      "source": "/masteradmin/:path*",
      "destination": "https://admin.getmeds.ph/masteradmin/:path*"
    },
    {
      "source": "/wp-json/:path*",
      "destination": "https://cms.getmeds.ph/wp-json/:path*"
    },
    {
      "source": "/api/careers",
      "destination": "https://getmeds-test-creation.vercel.app/api/careers"
    },
    {
      "source": "/api/:path*",
      "destination": "https://getmeds-admin.vercel.app/api/:path*"
    },
    {
      "source": "/masteradlorock",
      "destination": "https://admin.getmeds.ph/masteradlorock"
    },
    {
      "source": "/masteradlorock/:path*",
      "destination": "https://admin.getmeds.ph/masteradlorock/:path*"
    },
    {
      "source": "/masteradlorockpd",
      "destination": "https://admin.getmeds.ph/masteradlorockpd"
    },
    {
      "source": "/masteradlorockpd/:path*",
      "destination": "https://admin.getmeds.ph/masteradlorockpd/:path*"
    },
    {
      "source": "/masteradlorockpdprocess",
      "destination": "https://admin.getmeds.ph/masteradlorockpdprocess"
    },
    {
      "source": "/masteradlorockpdprocess/:path*",
      "destination": "https://admin.getmeds.ph/masteradlorockpdprocess/:path*"
    },
    {
      "source": "/masteradlogriyon",
      "destination": "https://admin.getmeds.ph/masteradlogriyon"
    },
    {
      "source": "/masteradlogriyon/:path*",
      "destination": "https://admin.getmeds.ph/masteradlogriyon/:path*"
    },
    {
      "source": "/adminadlorock",
      "destination": "https://admin.getmeds.ph/adminadlorock"
    },
    {
      "source": "/adminadlorock/:path*",
      "destination": "https://admin.getmeds.ph/adminadlorock/:path*"
    },
    {
      "source": "/cancer-medicines/:subcategory(breast-cancer|ovarian-cancer|lung-cancer|prostate-cancer|colorectal-cancer|pancreatic-cancer|aml|cml|lymphoma|sickle-cell|respiratory|uti|skin-infections|bone-infections|endometriosis|fibrocystic|multiple-myeloma|osteoporosis|arrhythmia|hypertension|glioblastoma|allergic-rhinitis|kidney-disease|pain|rheumatology|chronic-lymphocytic-leukemia)",
      "destination": "/cancer-medicines"
    },
    {
      "source": "/cancer-medicines/:product",
      "destination": "/product-detail"
    },
    {
      "source": "/cancer-medicines",
      "destination": "/cancer-medicines"
    },
    {
      "source": "/blog/:slug*",
      "destination": "/blog-detail"
    },
    {
      "source": "/blog-detail",
      "destination": "/blog-detail"
    },
    {
      "source": "/blog-detail.html",
      "destination": "/blog-detail"
    }
  ],
  "headers": [
    {
      "source": "/public/:path*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "http://localhost:5173"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization"
        },
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        }
      ]
    },
