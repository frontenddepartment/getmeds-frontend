{
  "version": 2,
  "framework": null,
  "installCommand": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/articles",
      "destination": "/blog",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/wp-json/:path*",
      "destination": "https://cms.getmeds.ph/wp-json/:path*"
    },
    {
      "source": "/api/careers",
      "destination": "https://getmeds-test-creation.vercel.app/api/careers"
    },
    {
      "source": "/api/:path*",
      "destination": "https://getmeds-admin.vercel.app/api/:path*"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog-detail.html"
    },
    {
      "source": "/article-detail",
      "destination": "/blog-detail.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}