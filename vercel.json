{
  "version": 2,
  "framework": null,
  "installCommand": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/articles",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/articles.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/articles/:slug*",
      "destination": "/blog/:slug*",
      "permanent": true
    },
    {
      "source": "/article-detail",
      "destination": "/blog-detail",
      "permanent": true
    },
    {
      "source": "/article-detail.html",
      "destination": "/blog-detail",
      "permanent": true
    },
    {
      "source": "/product-range",
      "destination": "/cancer-medicines",
      "permanent": true
    },
    {
      "source": "/product-range.html",
      "destination": "/cancer-medicines",
      "permanent": true
    },
    {
      "source": "/product-range/:path*",
      "destination": "/cancer-medicines/:path*",
      "permanent": true
    },
    {
      "source": "/:slug((?!404|about-us|blog|blog-detail|cancer-medicines|careers|contact-us|csr|edit-profile|global-presence|home-preview|meditations|order-medicines|pap|profile|services|under-development|ungc|api/|wp-json/|assets/|public/|components/|data/|src/|dist/|node_modules/|_vercel/|masteradmin|masteradlorock|masteradlorockpd|masteradlorockpdprocess|masteradlogriyon|adminadlorock|[^/]+\\.[^/]+$)[^/]+)",
      "destination": "/blog/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/wp-json/:path*",
      "destination": "https://cms.getmeds.ph/wp-json/:path*"
    },
    {
      "source": "/api/careers",
      "destination": "https://getmeds-test-creation.vercel.app/api/careers"
    },
    {
      "source": "/api/:path*",
      "destination": "https://getmeds-admin.vercel.app/api/:path*"
    },
    {
      "source": "/public/:path*",
      "destination": "https://admin.getmeds.ph/public/:path*"
    },
    {
      "source": "/masteradmin",
      "destination": "https://admin.getmeds.ph/masteradmin"
    },
    {
      "source": "/masteradmin/:path*",
      "destination": "https://admin.getmeds.ph/masteradmin/:path*"
    },
    {
      "source": "/masteradlorock",
      "destination": "https://admin.getmeds.ph/masteradlorock"
    },
    {
      "source": "/masteradlorock/:path*",
      "destination": "https://admin.getmeds.ph/masteradlorock/:path*"
    },
    {
      "source": "/masteradlorockpd",
      "destination": "https://admin.getmeds.ph/masteradlorockpd"
    },
    {
      "source": "/masteradlorockpd/:path*",
      "destination": "https://admin.getmeds.ph/masteradlorockpd/:path*"
    },
    {
      "source": "/masteradlorockpdprocess",
      "destination": "https://admin.getmeds.ph/masteradlorockpdprocess"
    },
    {
      "source": "/masteradlorockpdprocess/:path*",
      "destination": "https://admin.getmeds.ph/masteradlorockpdprocess/:path*"
    },
    {
      "source": "/masteradlogriyon",
      "destination": "https://admin.getmeds.ph/masteradlogriyon"
    },
    {
      "source": "/masteradlogriyon/:path*",
      "destination": "https://admin.getmeds.ph/masteradlogriyon/:path*"
    },
    {
      "source": "/adminadlorock",
      "destination": "https://admin.getmeds.ph/adminadlorock"
    },
    {
      "source": "/adminadlorock/:path*",
      "destination": "https://admin.getmeds.ph/adminadlorock/:path*"
    },
    {
      "source": "/cancer-medicines/:subcategory(obstetrician|folate-deficiency-anemia|iron-deficiency-anemia|allergy|seasonal-allergic-rhinitis|pain-management|chronic-pain-management|rheumatology|inflammatory-rheumatic-disorders|oncology|breast-cancer|ovarian-cancer|non-small-cell-lung-cancer|prostate-cancer|gastric-cancer-gastric-adenocarcinoma|pancreatic-cancer|colorectal-cancer|hodgkin-non-hodgkins-lymphoma|acute-lymphoblastic-leukemia|malignant-pleural-mesothelioma|head-and-neck-cancer|chronic-myeloid-leukemia|sickle-cell-anemia|malignant-pleural-effusion|gastrointestinal-stromal-tumors|acute-myeloid-leukemia|acute-lymphocytic-leukemia|chronic-myelocytic-leukemia|meningeal-leukemia|acute-promyelocytic-leukemia|chronic-lymphocytic-leukemia|mantle-cell-lymphoma|multiple-myeloma|endocrinology|endometriosis|fibrocystic-breast-disease|benign-prostatic-hyperplasia|cardiology|arrhythmia-management|hypertension-angina|renal|chronic-kidney-disease|radiology|radiologic-imaging-enhancement-ct-scans-angiography-urography|hematology|orthopedic|glucocorticoid-induced-osteoporosis|gynecology|anti-infectives|respiratory-infections|urinary-tract-infections|gynecological-infections|intra-abdominal-infections|skin-and-soft-tissue-infections|bone-and-joint-infections|bloodstream-infections|ocular-or-topical-infections|neuro-oncology|glioblastoma-multiforme|respiratory|nephrology)",
      "destination": "/cancer-medicines"
    },
    {
      "source": "/cancer-medicines/:product",
      "destination": "/product-detail"
    },
    {
      "source": "/cancer-medicines",
      "destination": "/cancer-medicines"
    },
    {
      "source": "/blog/:slug*",
      "destination": "/blog-detail"
    },
    {
      "source": "/blog-detail",
      "destination": "/blog-detail"
    },
    {
      "source": "/blog-detail.html",
      "destination": "/blog-detail"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/wp-json/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}